<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime: aligned to the current .NET 10.0 patch train -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="System.Management" Version="10.0.12" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
    <PackageVersion Include="Spectre.Console" Version="0.49.1" />
    <!--
      Test infrastructure — versioning notes (verified 2026-05-14):
        Microsoft.NET.Test.Sdk  17.14.1 → 18.10.1 available but BREAKING (new test-host protocol).
                                Intentionally held at 17.x until xunit v3 migration.
        xunit                   2.9.3   → 3.x available but BREAKING API / runner change.
                                This project is on xUnit v2; migrate in a dedicated sprint.
        xunit.runner.visualstudio 2.8.2 → 3.1.5 is the xUnit v3 runner — incompatible with v2.
                                Must stay on 2.x while on xUnit v2.
        FsCheck / FsCheck.Xunit 2.16.6 → 3.4.0 has breaking API changes.
                                Held at 2.x until migration; v3 needs different attribute usage.
        coverlet.collector      8.0.1 → 10.0.1 has a major-version change.
                                Held at 8.x until the test-host/tooling stack is reviewed.
    -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="8.0.1" />
    <!-- Benchmarking & property-based testing — current as of 2026-03-29 -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="FsCheck" Version="3.4.0" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.4.0" />
  </ItemGroup>
</Project>
